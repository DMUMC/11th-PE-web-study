{
  "info": {
    "name": "UMC 6주차 백엔드 필수 미션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    }
  ],
  "item": [
    {
      "name": "01 회원가입",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"nickname\": \"{{nickname}}\",\n  \"password\": \"Umc!1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const seed = Date.now().toString();",
              "pm.collectionVariables.set(\"email\", \"m\" + seed + \"@example.com\");",
              "pm.collectionVariables.set(\"nickname\", \"m\" + seed.slice(-10));",
              "pm.collectionVariables.set(\"otherEmail\", \"o\" + seed + \"@example.com\");",
              "pm.collectionVariables.set(\"otherNickname\", \"o\" + seed.slice(-10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.test(\"공통 응답\", () => pm.expect(data.isSuccess).to.eql(true));",
              "pm.collectionVariables.set(\"memberId\", data.result.memberId);",
              "pm.test(\"비밀번호 미노출\", () => pm.expect(data.result).not.to.have.property(\"password\"));"
            ]
          }
        }
      ]
    },
